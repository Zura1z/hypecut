# Copy this file to .env and fill in what you need. Both keys are optional.

# Needed only for --captions (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: Groq picks smarter clip start/end from the transcript, and backs up Gemini for the
# dashboard's Keep/Reject check (free key: https://console.groq.com/keys)
GROQ_API_KEY=

# Needed only for --ai (Claude scores and titles each clip)
ANTHROPIC_API_KEY=
